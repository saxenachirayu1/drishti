# Copy to .env and fill in. Never commit .env.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only: api/ and pipeline/

# IBM watsonx.ai (Granite)
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=
WATSONX_PROJECT_ID=

# NASA FIRMS
FIRMS_MAP_KEY=

# Pipeline: fine-tuned Prithvi checkpoint (leave empty to use the spectral baseline)
DRISHTI_CHECKPOINT=

# Email for complaints (leave empty to log instead of send)
RESEND_API_KEY=
