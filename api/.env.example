# Copy to ".env" and fill in as you get each service. EVERYTHING is optional:
# with all blank, the API runs fully offline (in-memory DB, template AI,
# console "email") so you can build and demo without waiting on anyone.
#
# See INTEGRATION.md for what to change when A's and B's work lands.

# --- Supabase (from Member A) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Set SUPABASE_JWT_SECRET to turn on real login checks. Leave it blank (and
# with no trailing comment on the same line) to keep the dev bypass.
SUPABASE_JWT_SECRET=

# Which data backend to use: auto | memory | supabase
#   auto     - Supabase if the keys above are set, else in-memory (default)
#   memory   - force in-memory, even with keys present (demo on real creds)
#   supabase - force Supabase; a missing key is then a loud error instead of a
#              silent fallback to seeded data. Use this once A is live.
REPO_BACKEND=auto

# --- watsonx.ai Granite (from your IBM account) ---
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=drishti@example.com

# --- Member B's pipeline ---
# Where POST /pipeline/run forwards to. Blank = the run is recorded only and
# the endpoint returns status "pending". See services/pipeline_adapter.py.
PIPELINE_WEBHOOK_URL=
PIPELINE_WEBHOOK_TOKEN=
# Shared secret B sends as the X-Ingest-Key header on POST /ingest.
# Blank = /ingest needs a normal officer/admin token instead.
INGEST_API_KEY=

# --- Tunables -------------------------------------------------------------
# All optional; the defaults shown are what the code uses if these are blank.
# GET /health prints the values actually in force.

# A fire_risk at or above this counts as a "burning" site (0-100).
FIRE_RISK_THRESHOLD=60

# City cleanliness score (C-14). Weights must add up to 100.
SCORE_WEIGHTS={"active":40,"burn":25,"clear_time":20,"verified":15}
# The value at which each part scores zero.
SCORE_CAPS={"active_per_km2":5.0,"burn_events":20,"median_days":60.0}
# City areas in km2, for the active-site density part. Add cities here.
CITY_AREA_KM2={"indore":530.0,"bhopal":463.0}
FALLBACK_CITY_AREA_KM2=400.0
# Stand-in until complaints have been through a full sent->cleared cycle.
DEFAULT_MEDIAN_DAYS_TO_CLEAR=30.0

# Verification (C-12). Tune against B's revisit rate and detector noise.
VERIFY_CLEAR_SCENES=2        # scenes with no detection before "cleared"
VERIFY_SHRINK_RATIO=0.8      # newest area below this x oldest = "shrinking"

# Citizen-report matching (C-13): link a report to a site within this radius.
REPORT_MATCH_RADIUS_M=150

# Browser origins allowed to call this API (comma-separated).
# "*" is fine locally; set it to the dashboard's origin before deploying.
ALLOWED_ORIGINS=*

# Port to listen on. Hosts inject this: Spaces 7860, Code Engine 8080.
PORT=8000

# --- Dev convenience ---
# When SUPABASE_JWT_SECRET is blank, every request is treated as this role.
# Set to "admin" to try /verifications/run and /pipeline/run.
DEV_ROLE=officer
# Set to 0 to keep background jobs off.
RUN_SCHEDULER=1
